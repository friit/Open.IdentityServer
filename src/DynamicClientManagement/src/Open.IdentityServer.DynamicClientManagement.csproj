<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <PackageId>Open.IdentityServer.DynamicClientManagement</PackageId>
        <TargetFramework>net10.0</TargetFramework>
        <Description>Dynamic Client Management for Open.IdentityServer</Description>
        <Authors>Jo Stevens;Rock Solid Knowledge</Authors>
        <AssemblyName>Open.IdentityServer.DynamicClientManagement</AssemblyName>
        <PackageTags>OAuth2;OAuth 2.0;OpenID Connect;Security;Identity;IdentityServer;Dynamic Client Management</PackageTags>
        <ImplicitUsings>enable</ImplicitUsings>
        <PackageProjectUrl>https://github.com/RockSolidKnowledge/Open.IdentityServer</PackageProjectUrl>
        <PackageIcon>OpenIdentityServerIcon.png</PackageIcon>
        <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
        <Nullable>enable</Nullable>
        <PackageReadmeFile>README.md</PackageReadmeFile>
    </PropertyGroup>

    <ItemGroup>
        <FrameworkReference Include="Microsoft.AspNetCore.App" />
    </ItemGroup>
    
    <ItemGroup>
        <None Include="README.md" Pack="true" Visible="false" PackagePath=""/>
        <None Include="../../../OpenIdentityServerIcon.png" Pack="true" Visible="false" PackagePath=""/>
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\..\Storage\src\Open.IdentityServer.Storage.csproj" />
    </ItemGroup>

    <ItemGroup>
      <PackageReference Include="Microsoft.IdentityModel.Tokens" Version="8.19.1"/>
      <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.19.1"/>
    </ItemGroup>
</Project>
