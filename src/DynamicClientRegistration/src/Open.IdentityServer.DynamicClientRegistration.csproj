<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <PackageId>Open.IdentityServer.DynamicClientRegistration</PackageId>
        <TargetFramework>net10.0</TargetFramework>
        <Description>Dynamic Client Registration for Open.IdentityServer</Description>
        <Authors>Jo Stevens;Rock Solid Knowledge</Authors>
        <AssemblyName>Open.IdentityServer.DynamicClientRegistration</AssemblyName>
        <PackageTags>OAuth2;OAuth 2.0;OpenID Connect;Security;Identity;IdentityServer;Dynamic Client Registration</PackageTags>
        <ImplicitUsings>enable</ImplicitUsings>
        <PackageProjectUrl>https://github.com/RockSolidKnowledge/Open.IdentityServer</PackageProjectUrl>
        <PackageIcon>OpenIdentityServerIcon.png</PackageIcon>
        <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
        <Nullable>enable</Nullable>
        <PackageReadmeFile>README.md</PackageReadmeFile>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Open.IdentityServer"/>   
    </ItemGroup>

    <ItemGroup>
        <None Include="README.md" Pack="true" Visible="false" PackagePath=""/>
        <None Include="../../../OpenIdentityServerIcon.png" Pack="true" Visible="false" PackagePath=""/>
    </ItemGroup>
</Project>
